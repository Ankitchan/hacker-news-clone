# Docker Deployment Configuration

# Server
PORT=8080
ENV=production

# Database
DB_USER=postgres
DB_PASSWORD=postgres_secure_password_change_me
DB_NAME=hackernews_clone
DB_PORT=5432
DB_SSL_MODE=disable

# JWT
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_change_this
JWT_EXPIRATION_HOURS=72

# CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Spam Detection (Optional - set to false to disable)
SPAM_DETECTION_ENABLED=false
HF_API_KEY=
HF_SPAM_MODEL=mrm8488/bert-tiny-finetuned-sms-spam-detection
